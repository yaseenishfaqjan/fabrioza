# ------------------------------------------------------------------
# FABRIOZA CRM — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- Supabase (Phase 1) ---
# From Supabase project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key is SERVER-ONLY (full DB access, bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Form intake auth (Phase 2) ---
# Shared secret the website/PHP forwarder must send in the `x-api-key` header.
# Generate a long random string, e.g.  openssl rand -hex 32
# KEEP THIS SERVER-SIDE ONLY — never put it in browser/client JavaScript.
FORM_INTAKE_SECRET=

# --- OpenAI agent (Phase 4) ---
OPENAI_API_KEY=
# Model the lead agent uses. Default gpt-4o-mini (cheap); set gpt-4o for best drafts.
OPENAI_MODEL=gpt-4o-mini
# Sampling temperature for drafts (0=deterministic, ~0.4 = warm but consistent).
OPENAI_TEMPERATURE=0.4

# --- Dashboard auth (Phase 5) ---
DASHBOARD_PASSWORD=
# Used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# --- Email intake via IMAP (Phase 3) ---
# cPanel → Email Accounts → Connect Devices → "Secure SSL/TLS Settings".
IMAP_HOST=mail.fabrioza.com
IMAP_PORT=993
IMAP_USER=info@fabrioza.com
IMAP_PASSWORD=
IMAP_TLS=true
# How often the worker polls IMAP, in seconds (default 180 = 3 min).
EMAIL_POLL_SECONDS=180

# --- Gmail draft for replies (Phase 5) ---
# Desktop OAuth client, scope gmail.compose. Get the refresh token with: npm run gmail:token
# Drafts are created in (and sent from) the authenticated account — NO "send as".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# GMAIL_SEND_AS is no longer used (kept for reference only).
GMAIL_SEND_AS=
